      <!-- Empty State -->
      <div id="emptyState" class="hidden p-12 text-center">
        <div class="w-16 h-16 bg-brand-50 text-brand-600 rounded-full flex items-center justify-center mx-auto mb-3">
          <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
        </div>
        <h3 class="text-base font-bold text-slate-800">Your Stuck Point Log is Empty</h3>
        <p class="text-xs text-slate-500 max-w-md mx-auto mt-1 mb-4">
          Add your first stuck point from your Impact Statement above, or click "Load Examples" to explore clinical examples.
        </p>
        <button id="emptyLoadBtn" class="px-4 py-2 bg-brand-600 text-white rounded-lg text-xs font-semibold hover:bg-brand-500 transition">
          Load Sample CPT Stuck Points
        </button>
