      </form>
    </section>

    <!-- Stuck Point Log View Table & Controls -->
    <section class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden">
      <!-- Toolbar: Filter, Search, Export -->
      <div class="p-4 bg-slate-50/80 border-b border-slate-200 flex flex-col md:flex-row md:items-center md:justify-between gap-3 no-print">
        <div class="flex flex-wrap items-center gap-2">
