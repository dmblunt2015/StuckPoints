    <!-- Clinical Protocol Notes Footer -->
    <footer class="text-xs text-slate-500 space-y-2 border-t border-slate-200 pt-4">
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2">
        <p><strong>CPT Protocol Guidance:</strong> Keep this log in the front of your therapy materials. Add stuck points as they arise from natural recovery obstacles, triggers, or worksheets.</p>
        <p class="text-slate-400">Cognitive Processing Therapy (CPT) • Standard Protocol</p>
      </div>
    </footer>
  </main>

  <!-- Interactive Logic -->
  <script>
    // Storage Key
    const STORAGE_KEY = 'cpt_stuck_point_log_data_v1';

    // State
    let logState = {
      clientName: '',
      logDate: '',
      logTime: '',
      clinician: '',
      stuckPoints: []
    };

    let currentFilter = 'all';
    let currentThemeFilter = 'all';
    let searchQuery = '';

    // Sample CPT Clinical Data
    const SAMPLE_STUCK_POINTS = [
      {
        id: 'sp_1',
        timestamp: new Date(Date.now() - 86400000 * 5).toISOString(),
        dateTimeFormatted: '2026-10-13 09:30',
        text: 'If I had paid closer attention to the warning signs, this never would have happened.',
        theme: 'Esteem',
        category: 'Assimilation',
        initialBelief: 95,
        worksheet: 'Challenging Questions Worksheet',
        alternativeThought: 'I made the safest choices I could with the knowledge I had at the time. I cannot predict the future, and the fault lies solely with the perpetrator.',
        currentBelief: 15,
        status: 'Resolved'
      },
      {
        id: 'sp_2',
        timestamp: new Date(Date.now() - 86400000 * 3).toISOString(),
        dateTimeFormatted: '2026-10-15 14:15',
        text: 'People in positions of authority can never be trusted under any circumstances.',
        theme: 'Trust',
        category: 'Over-Accommodation',
        initialBelief: 100,
        worksheet: 'Alternative Thoughts Worksheet',
        alternativeThought: 'While some individuals abuse authority, many people are dedicated and trustworthy. Trust should be evaluated gradually based on specific behavioral evidence.',
        currentBelief: 30,
        status: 'In Progress'
      },
      {
        id: 'sp_3',
        timestamp: new Date(Date.now() - 86400000 * 1).toISOString(),
        dateTimeFormatted: '2026-10-17 11:00',
        text: 'Nowhere in public is safe; harm can occur anywhere at any second.',
        theme: 'Safety',
        category: 'Over-Accommodation',
        initialBelief: 90,
        worksheet: 'Patterns of Problematic Thinking',
        alternativeThought: 'No environment is 100% risk-free, but most places I visit are reasonably safe. I can take sensible precautions without living in constant isolation.',
        currentBelief: 45,
        status: 'In Progress'
      },
      {
        id: 'sp_4',
        timestamp: new Date().toISOString(),
        dateTimeFormatted: '2026-10-18 01:00',
        text: 'I should have fought harder instead of freezing during the incident.',
        theme: 'Power/Control',
        category: 'Assimilation',
        initialBelief: 100,
        worksheet: 'Not yet examined',
        alternativeThought: '',
        currentBelief: 100,
        status: 'Active'
      }
    ];

    // Helper: Toast Notifications
    function showToast(message, type = 'info') {
      const container = document.getElementById('toastContainer');
      const toast = document.createElement('div');
      
      const bgColors = {
        success: 'bg-emerald-600 text-white',
        error: 'bg-red-600 text-white',
        info: 'bg-slate-800 text-white',
        warning: 'bg-amber-600 text-white'
      };

      toast.className = `${bgColors[type] || bgColors.info} px-4 py-2.5 rounded-lg shadow-lg text-xs font-semibold flex items-center gap-2 transform transition-all duration-300 pointer-events-auto max-w-sm`;
      toast.innerHTML = `
        <span>${message}</span>
        <button class="ml-auto text-white/80 hover:text-white font-bold">&times;</button>
      `;

      toast.querySelector('button').addEventListener('click', () => {
        toast.remove();
      });

      container.appendChild(toast);
      setTimeout(() => {
        toast.classList.add('opacity-0', 'translate-x-4');
        setTimeout(() => toast.remove(), 300);
      }, 3500);
    }

    // Helper: In-page Modal (No alert/confirm)
    function showModal({ title, body, confirmText = 'Confirm', cancelText = 'Cancel', onConfirm }) {
      const overlay = document.getElementById('modalOverlay');
      const titleEl = document.getElementById('modalTitle');
      const bodyEl = document.getElementById('modalBody');
      const actionsEl = document.getElementById('modalActions');

      titleEl.textContent = title;
      bodyEl.textContent = body;
      actionsEl.innerHTML = '';

      if (cancelText) {
        const cancelBtn = document.createElement('button');
        cancelBtn.className = 'px-4 py-2 text-xs font-semibold text-slate-600 hover:text-slate-800 border border-slate-300 rounded-lg transition';
        cancelBtn.textContent = cancelText;
        cancelBtn.addEventListener('click', () => {
          overlay.classList.add('hidden');
        });
        actionsEl.appendChild(cancelBtn);
      }

      const confirmBtn = document.createElement('button');
      confirmBtn.className = 'px-4 py-2 text-xs font-semibold bg-brand-600 hover:bg-brand-500 text-white rounded-lg shadow transition';
      confirmBtn.textContent = confirmText;
      confirmBtn.addEventListener('click', () => {
        overlay.classList.add('hidden');
        if (typeof onConfirm === 'function') onConfirm();
      });
      actionsEl.appendChild(confirmBtn);

      overlay.classList.remove('hidden');
    }

    // Load from LocalStorage
    function loadSavedData() {
      try {
        const raw = localStorage.getItem(STORAGE_KEY);
        if (raw) {
          const parsed = JSON.parse(raw);
          logState = Object.assign(logState, parsed);
        }
      } catch (e) {
        console.warn('LocalStorage unavailable or disabled:', e);
      }

      // Initialize form fields
      document.getElementById('clientNameInput').value = logState.clientName || '';
      document.getElementById('logDateInput').value = logState.logDate || '';
      document.getElementById('logTimeInput').value = logState.logTime || '';
      document.getElementById('clinicianInput').value = logState.clinician || '';

      // If date/time not set, default to today
      if (!logState.logDate || !logState.logTime) {
        setDefaultDateTime();
      }

      updatePrintHeader();
      renderLog();
    }

    // Save to LocalStorage
    function persistData() {
      try {
        logState.clientName = document.getElementById('clientNameInput').value.trim();
        logState.logDate = document.getElementById('logDateInput').value;
        logState.logTime = document.getElementById('logTimeInput').value;
        logState.clinician = document.getElementById('clinicianInput').value.trim();
        localStorage.setItem(STORAGE_KEY, JSON.stringify(logState));
      } catch (e) {
        console.warn('LocalStorage save failed:', e);
      }
      updatePrintHeader();
      updateStats();
    }

    function setDefaultDateTime() {
      const now = new Date();
      const year = now.getFullYear();
      const month = String(now.getMonth() + 1).padStart(2, '0');
      const day = String(now.getDate()).padStart(2, '0');
      const hours = String(now.getHours()).padStart(2, '0');
      const minutes = String(now.getMinutes()).padStart(2, '0');

      if (!document.getElementById('logDateInput').value) {
        document.getElementById('logDateInput').value = `${year}-${month}-${day}`;
        logState.logDate = `${year}-${month}-${day}`;
      }
      if (!document.getElementById('logTimeInput').value) {
        document.getElementById('logTimeInput').value = `${hours}:${minutes}`;
        logState.logTime = `${hours}:${minutes}`;
      }
    }

    function updatePrintHeader() {
      const name = document.getElementById('clientNameInput').value.trim() || '—';
      const d = document.getElementById('logDateInput').value || '—';
      const t = document.getElementById('logTimeInput').value || '';
      const clin = document.getElementById('clinicianInput').value.trim() || '—';

      document.getElementById('printClientName').textContent = name;
      document.getElementById('printDateTime').textContent = `${d} ${t}`.trim();
      document.getElementById('printClinician').textContent = clin;
    }

    // Update Statistics
    function updateStats() {
      const total = logState.stuckPoints.length;
      const resolved = logState.stuckPoints.filter(p => p.status === 'Resolved').length;
      const active = total - resolved;

      let totalDrop = 0;
      let countWithReframe = 0;

      logState.stuckPoints.forEach(p => {
        if (p.initialBelief !== undefined && p.currentBelief !== undefined) {
          totalDrop += (p.initialBelief - p.currentBelief);
          countWithReframe++;
        }
      });

      const avgDrop = countWithReframe > 0 ? Math.round(totalDrop / countWithReframe) : 0;

      document.getElementById('statTotal').textContent = total;
      document.getElementById('statActive').textContent = active;
      document.getElementById('statResolved').textContent = resolved;
      document.getElementById('statBeliefChange').textContent = avgDrop >= 0 ? `-${avgDrop}%` : `+${Math.abs(avgDrop)}%`;

      document.getElementById('countAll').textContent = total;
      document.getElementById('countActive').textContent = active;
      document.getElementById('countResolved').textContent = resolved;
    }

    // Theme Badges Styling
    function getThemeBadge(theme) {
      const themes = {
        'Safety': 'bg-red-50 text-red-700 border-red-200',
        'Trust': 'bg-blue-50 text-blue-700 border-blue-200',
        'Power/Control': 'bg-purple-50 text-purple-700 border-purple-200',
        'Esteem': 'bg-emerald-50 text-emerald-700 border-emerald-200',
        'Intimacy': 'bg-pink-50 text-pink-700 border-pink-200',
        'Self-Blame': 'bg-amber-50 text-amber-700 border-amber-200'
      };
      const cls = themes[theme] || 'bg-slate-100 text-slate-700 border-slate-200';
      return `<span class="inline-block px-2 py-0.5 rounded text-[11px] font-semibold border ${cls}">${theme}</span>`;
    }

    // Status Badges
    function getStatusBadge(status) {
      if (status === 'Resolved') {
        return `<span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-bold bg-emerald-100 text-emerald-800 border border-emerald-300">
                  <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
                  Crossed Off
                </span>`;
      }
      if (status === 'In Progress') {
        return `<span class="inline-block px-2.5 py-0.5 rounded-full text-xs font-medium bg-amber-100 text-amber-800 border border-amber-200">In Progress</span>`;
      }
      return `<span class="inline-block px-2.5 py-0.5 rounded-full text-xs font-medium bg-slate-100 text-slate-700 border border-slate-200">Active</span>`;
    }

    // Render Table
    function renderLog() {
      const tbody = document.getElementById('stuckPointTableBody');
      const emptyState = document.getElementById('emptyState');
      tbody.innerHTML = '';

      let items = logState.stuckPoints;

      // Filter Status
      if (currentFilter === 'active') {
        items = items.filter(p => p.status !== 'Resolved');
      } else if (currentFilter === 'resolved') {
        items = items.filter(p => p.status === 'Resolved');
      }

      // Filter Theme
      if (currentThemeFilter !== 'all') {
        items = items.filter(p => p.theme === currentThemeFilter);
      }

      // Filter Search
      if (searchQuery) {
        const q = searchQuery.toLowerCase();
        items = items.filter(p => 
          p.text.toLowerCase().includes(q) || 
          (p.alternativeThought && p.alternativeThought.toLowerCase().includes(q)) ||
          p.theme.toLowerCase().includes(q)
        );
      }

      if (logState.stuckPoints.length === 0) {
        emptyState.classList.remove('hidden');
      } else {
        emptyState.classList.add('hidden');
      }

      if (items.length === 0 && logState.stuckPoints.length > 0) {
        tbody.innerHTML = `<tr><td colspan="9" class="text-center py-8 text-xs text-slate-400">No stuck points match your active filter.</td></tr>`;
        updateStats();
        return;
      }

      items.forEach((item, index) => {
        const tr = document.createElement('tr');
        const isResolved = item.status === 'Resolved';
        tr.className = `hover:bg-slate-50/70 transition-colors ${isResolved ? 'bg-slate-50/40' : ''}`;

        tr.innerHTML = `
          <td class="py-3 px-3 text-center text-xs font-bold text-slate-500">${index + 1}</td>
          <td class="py-3 px-3 text-xs text-slate-500 whitespace-nowrap">
            <div>${item.dateTimeFormatted || '—'}</div>
            <div class="text-[10px] text-slate-400 font-mono">${item.worksheet || ''}</div>
          </td>
          <td class="py-3 px-4">
            <div class="font-medium text-slate-900 leading-snug ${isResolved ? 'crossed-off' : ''}">${escapeHtml(item.text)}</div>
            ${isResolved ? '<span class="inline-block mt-1 text-[10px] text-emerald-700 bg-emerald-50 px-1.5 py-0.5 rounded font-semibold">Accommodated / Unstuck</span>' : ''}
          </td>
          <td class="py-3 px-3">
            <div class="flex flex-col gap-1 items-start">
              ${getThemeBadge(item.theme)}
              <span class="text-[10px] text-slate-500">${item.category}</span>
            </div>
          </td>
          <td class="py-3 px-3 text-center">
            <span class="font-bold text-xs ${item.initialBelief > 75 ? 'text-red-700' : 'text-slate-700'}">${item.initialBelief}%</span>
          </td>
          <td class="py-3 px-4 text-xs">
            ${item.alternativeThought ? `<div class="text-tealbrand-900 bg-tealbrand-50/50 p-2 rounded border border-tealbrand-100 italic">"${escapeHtml(item.alternativeThought)}"</div>` : '<span class="text-slate-400 italic">Worksheet in progress...</span>'}
          </td>
          <td class="py-3 px-3 text-center">
            <div class="inline-flex flex-col items-center">
              <span class="font-bold text-xs ${item.currentBelief < 30 ? 'text-emerald-700' : 'text-amber-700'}">${item.currentBelief}%</span>
              ${item.initialBelief > item.currentBelief ? `<span class="text-[10px] text-emerald-600 font-semibold">-${item.initialBelief - item.currentBelief}%</span>` : ''}
            </div>
          </td>
          <td class="py-3 px-3 text-center">
            ${getStatusBadge(item.status)}
          </td>
          <td class="py-3 px-3 text-center no-print">
            <div class="flex items-center justify-center gap-1.5">
              <button data-action="toggle-resolve" data-id="${item.id}" title="${isResolved ? 'Mark active' : 'Cross off (Resolved!)'}" 
                      class="p-1.5 rounded-lg border ${isResolved ? 'bg-emerald-50 border-emerald-300 text-emerald-700 hover:bg-emerald-100' : 'bg-white border-slate-300 text-slate-600 hover:bg-slate-100 hover:text-emerald-600'} transition">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              </button>
              <button data-action="edit" data-id="${item.id}" title="Edit stuck point" 
                      class="p-1.5 rounded-lg border bg-white border-slate-300 text-slate-600 hover:bg-slate-100 hover:text-brand-600 transition">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"/></svg>
              </button>
              <button data-action="delete" data-id="${item.id}" title="Delete" 
                      class="p-1.5 rounded-lg border bg-white border-slate-300 text-slate-600 hover:bg-red-50 hover:text-red-600 transition">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
              </button>
            </div>
          </td>
        `;

        tbody.appendChild(tr);
      });

      updateStats();
    }

    function escapeHtml(str) {
      if (!str) return '';
      return str.replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#039;');
    }

    // Toggle Resolve (Cross off)
    function toggleResolve(id) {
      const item = logState.stuckPoints.find(p => p.id === id);
      if (!item) return;

      if (item.status === 'Resolved') {
        item.status = 'In Progress';
        showToast('Stuck point marked back in progress.', 'info');
      } else {
        item.status = 'Resolved';
        // Auto-lower current belief if it was still high
        if (item.currentBelief > 20) {
          item.currentBelief = 10;
        }
        showToast('🎉 Stuck point crossed off! Great progress on your CPT recovery.', 'success');
      }
      persistData();
      renderLog();
    }

    // Edit Item
    function editItem(id) {
      const item = logState.stuckPoints.find(p => p.id === id);
      if (!item) return;

      document.getElementById('editingId').value = item.id;
      document.getElementById('spText').value = item.text;
      document.getElementById('spTheme').value = item.theme;
      document.getElementById('spCategory').value = item.category;
      document.getElementById('spInitialBelief').value = item.initialBelief;
      document.getElementById('spInitialBeliefVal').textContent = `${item.initialBelief}%`;
      document.getElementById('spStatus').value = item.status;
      document.getElementById('spAlternative').value = item.alternativeThought || '';
      document.getElementById('spWorksheetUsed').value = item.worksheet || 'Not yet examined';
      document.getElementById('spCurrentBelief').value = item.currentBelief !== undefined ? item.currentBelief : item.initialBelief;
      document.getElementById('spCurrentBeliefVal').textContent = `${document.getElementById('spCurrentBelief').value}%`;

      document.getElementById('formHeaderTitle').textContent = `Editing Stuck Point #${logState.stuckPoints.indexOf(item) + 1}`;
      document.getElementById('submitBtnText').textContent = 'Update Stuck Point';
      document.getElementById('cancelEditBtn').classList.remove('hidden');

      // Scroll to form
      document.getElementById('stuckPointForm').scrollIntoView({ behavior: 'smooth' });
    }

    // Cancel Edit
    function cancelEdit() {
      document.getElementById('editingId').value = '';
      document.getElementById('stuckPointForm').reset();
      document.getElementById('spInitialBeliefVal').textContent = '100%';
      document.getElementById('spCurrentBeliefVal').textContent = '100%';
      document.getElementById('formHeaderTitle').textContent = 'Add New Stuck Point';
      document.getElementById('submitBtnText').textContent = 'Add Stuck Point to Log';
      document.getElementById('cancelEditBtn').classList.add('hidden');
      document.getElementById('cptTipBadge').classList.add('hidden');
    }

    // Delete Item
    function deleteItem(id) {
      showModal({
        title: 'Delete Stuck Point?',
        body: 'Are you sure you want to remove this stuck point from your log? This action cannot be undone.',
        confirmText: 'Delete',
        cancelText: 'Cancel',
        onConfirm: () => {
          logState.stuckPoints = logState.stuckPoints.filter(p => p.id !== id);
          persistData();
          renderLog();
          showToast('Stuck point removed.', 'info');
        }
      });
    }

    // Download Complete Standalone HTML
    function downloadHtmlFile() {
      // Create a fresh clone of the document
      const clientName = document.getElementById('clientNameInput').value.trim() || 'Client';
      const cleanFileName = `CPT_Stuck_Point_Log_${clientName.replace(/[^a-zA-Z0-9_-]/g, '_')}.html`;

      // Embed the current state directly into the script tag for standalone offline opening
      const htmlString = `<!DOCTYPE html>
${document.documentElement.outerHTML}`;

      // Replace or update embedded initial state so offline opened file carries data
      // Replace or update embedded initial state so offline opened file carries data
      const stateInjection = '<' + 'script>\n' +
        '    // Embedded Client State for Downloaded Log\n' +
        '    window.EMBEDDED_CPT_STATE = ' + JSON.stringify(logState, null, 2) + ';\n' +
        '  <' + '/script>\n';

      const finalizedHtml = htmlString.replace('</head>', stateInjection + '</head>');

      const blob = new Blob([finalizedHtml], { type: 'text/html;charset=utf-8' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = cleanFileName;
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      URL.revokeObjectURL(url);

      showToast('Download started! You can open this file anytime in your web browser.', 'success');
    }

    // Export CSV
    function exportToCsv() {
      if (logState.stuckPoints.length === 0) {
        showToast('No entries to export.', 'warning');
        return;
      }

      const client = document.getElementById('clientNameInput').value.trim() || 'Client';
      const headers = ['Item #', 'Date & Time', 'Stuck Point Statement', 'Theme', 'Thinking Type', 'Initial Belief (%)', 'Worksheet Used', 'Alternative Thought', 'Current Belief (%)', 'Status'];
      
      const rows = logState.stuckPoints.map((item, idx) => [
        idx + 1,
        `"${(item.dateTimeFormatted || '').replace(/"/g, '""')}"`,
        `"${(item.text || '').replace(/"/g, '""')}"`,
        `"${(item.theme || '').replace(/"/g, '""')}"`,
        `"${(item.category || '').replace(/"/g, '""')}"`,
        item.initialBelief,
        `"${(item.worksheet || '').replace(/"/g, '""')}"`,
        `"${(item.alternativeThought || '').replace(/"/g, '""')}"`,
        item.currentBelief,
        `"${(item.status || '').replace(/"/g, '""')}"`
      ]);

      const csvContent = [headers.join(','), ...rows.map(r => r.join(','))].join('\n');
      const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = `CPT_Stuck_Point_Log_${client.replace(/[^a-zA-Z0-9_-]/g, '_')}.csv`;
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      URL.revokeObjectURL(url);

      showToast('Exported to CSV successfully.', 'success');
    }

    // Export JSON
    function exportToJson() {
      const client = document.getElementById('clientNameInput').value.trim() || 'Client';
      const dataStr = "data:text/json;charset=utf-8," + encodeURIComponent(JSON.stringify(logState, null, 2));
      const a = document.createElement('a');
      a.href = dataStr;
      a.download = `CPT_Stuck_Point_Backup_${client.replace(/[^a-zA-Z0-9_-]/g, '_')}.json`;
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      showToast('JSON backup downloaded.', 'success');
    }

    // Import JSON
    function handleJsonImport(event) {
      const file = event.target.files[0];
      if (!file) return;

      const reader = new FileReader();
      reader.onload = function(e) {
        try {
          const parsed = JSON.parse(e.target.result);
          if (parsed && Array.isArray(parsed.stuckPoints)) {
            logState = parsed;
            persistData();
            loadSavedData();
            showToast('Log successfully restored from backup!', 'success');
          } else {
            showToast('Invalid backup file format.', 'error');
          }
        } catch (err) {
          showToast('Failed to parse JSON file.', 'error');
        }
      };
      reader.readAsText(file);
    }

    // Set Current Date & Time Action
    function setNowAction() {
      const now = new Date();
      const year = now.getFullYear();
      const month = String(now.getMonth() + 1).padStart(2, '0');
      const day = String(now.getDate()).padStart(2, '0');
      const hours = String(now.getHours()).padStart(2, '0');
      const minutes = String(now.getMinutes()).padStart(2, '0');

      document.getElementById('logDateInput').value = `${year}-${month}-${day}`;
      document.getElementById('logTimeInput').value = `${hours}:${minutes}`;
      persistData();
      showToast('Date and time set to current.', 'info');
    }

    // Event Listeners Initialization
    window.addEventListener('DOMContentLoaded', () => {
      // Check if opened from a downloaded standalone file with embedded state
      if (window.EMBEDDED_CPT_STATE && Array.isArray(window.EMBEDDED_CPT_STATE.stuckPoints)) {
        logState = window.EMBEDDED_CPT_STATE;
      }

      loadSavedData();

      // Form Text live tip
      const spTextInput = document.getElementById('spText');
      const cptTipBadge = document.getElementById('cptTipBadge');
      spTextInput.addEventListener('input', (e) => {
        const val = e.target.value.trim().toLowerCase();
        if (val.startsWith('i feel') || val.startsWith('feeling')) {
          cptTipBadge.classList.remove('hidden');
        } else {
          cptTipBadge.classList.add('hidden');
        }
      });

      // Range Sliders
      const initialSlider = document.getElementById('spInitialBelief');
      const initialVal = document.getElementById('spInitialBeliefVal');
      initialSlider.addEventListener('input', () => {
        initialVal.textContent = `${initialSlider.value}%`;
      });

      const currentSlider = document.getElementById('spCurrentBelief');
      const currentVal = document.getElementById('spCurrentBeliefVal');
      currentSlider.addEventListener('input', () => {
        currentVal.textContent = `${currentSlider.value}%`;
      });

      // Save Form Submit
      document.getElementById('stuckPointForm').addEventListener('submit', (e) => {
        e.preventDefault();
        const text = document.getElementById('spText').value.trim();
        if (!text) {
          showToast('Please enter a Stuck Point thought or belief.', 'warning');
          document.getElementById('spText').focus();
          return;
        }

        const editingId = document.getElementById('editingId').value;
        const theme = document.getElementById('spTheme').value;
        const category = document.getElementById('spCategory').value;
        const initialBelief = parseInt(document.getElementById('spInitialBelief').value, 10);
        const status = document.getElementById('spStatus').value;
        const alternativeThought = document.getElementById('spAlternative').value.trim();
        const worksheet = document.getElementById('spWorksheetUsed').value;
        const currentBelief = parseInt(document.getElementById('spCurrentBelief').value, 10);

        const now = new Date();
        const formattedDate = `${now.getFullYear()}-${String(now.getMonth()+1).padStart(2,'0')}-${String(now.getDate()).padStart(2,'0')} ${String(now.getHours()).padStart(2,'0')}:${String(now.getMinutes()).padStart(2,'0')}`;

        if (editingId) {
          // Update
          const item = logState.stuckPoints.find(p => p.id === editingId);
          if (item) {
            item.text = text;
            item.theme = theme;
            item.category = category;
            item.initialBelief = initialBelief;
            item.status = status;
            item.alternativeThought = alternativeThought;
            item.worksheet = worksheet;
            item.currentBelief = currentBelief;
            showToast('Stuck point updated.', 'success');
          }
          cancelEdit();
        } else {
          // New
          const newItem = {
            id: 'sp_' + Date.now(),
            timestamp: now.toISOString(),
            dateTimeFormatted: formattedDate,
            text,
            theme,
            category,
            initialBelief,
            status,
            alternativeThought,
            worksheet,
            currentBelief
          };
          logState.stuckPoints.unshift(newItem);
          showToast('Stuck point added to log.', 'success');
          cancelEdit();
        }

        persistData();
        renderLog();
      });

      // Header input auto-saving
      ['clientNameInput', 'logDateInput', 'logTimeInput', 'clinicianInput'].forEach(id => {
        document.getElementById(id).addEventListener('input', persistData);
      });

      // Set Now Button
      document.getElementById('setNowBtn').addEventListener('click', setNowAction);

      // Cancel Edit Button
      document.getElementById('cancelEditBtn').addEventListener('click', cancelEdit);

      // Table Action Delegations
      document.getElementById('stuckPointTableBody').addEventListener('click', (e) => {
        const btn = e.target.closest('button[data-action]');
        if (!btn) return;
        const action = btn.getAttribute('data-action');
        const id = btn.getAttribute('data-id');

        if (action === 'toggle-resolve') {
          toggleResolve(id);
        } else if (action === 'edit') {
          editItem(id);
        } else if (action === 'delete') {
          deleteItem(id);
        }
      });

      // Filter Buttons
      document.querySelectorAll('.filter-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          document.querySelectorAll('.filter-btn').forEach(b => {
            b.classList.remove('active', 'bg-brand-600', 'text-white');
            b.classList.add('bg-white', 'text-slate-600');
          });
          btn.classList.add('active', 'bg-brand-600', 'text-white');
          btn.classList.remove('bg-white', 'text-slate-600');
          currentFilter = btn.getAttribute('data-filter');
          renderLog();
        });
      });

      // Theme Filter Select
      document.getElementById('themeFilter').addEventListener('change', (e) => {
        currentThemeFilter = e.target.value;
        renderLog();
      });

      // Search input
      document.getElementById('searchInput').addEventListener('input', (e) => {
        searchQuery = e.target.value.trim();
        renderLog();
      });

      // Educational Guide Modal Triggers
      const guideModal = document.getElementById('guideModal');
      document.getElementById('openGuideBtn').addEventListener('click', () => {
        guideModal.classList.remove('hidden');
      });
      document.getElementById('closeGuideBtn').addEventListener('click', () => {
        guideModal.classList.add('hidden');
      });
      document.getElementById('closeGuideBottomBtn').addEventListener('click', () => {
        guideModal.classList.add('hidden');
      });

      // Load Clinical Samples
      const loadSamples = () => {
        logState.stuckPoints = JSON.parse(JSON.stringify(SAMPLE_STUCK_POINTS));
        if (!logState.clientName) {
          logState.clientName = 'Clinical Example Case';
          document.getElementById('clientNameInput').value = logState.clientName;
        }
        persistData();
        renderLog();
        showToast('Sample CPT clinical stuck points loaded.', 'success');
      };

      document.getElementById('loadSamplesBtn').addEventListener('click', () => {
        if (logState.stuckPoints.length > 0) {
          showModal({
            title: 'Load Clinical Examples?',
            body: 'This will replace your current entries with standard CPT clinical example stuck points across Safety, Trust, Esteem, and Control.',
            confirmText: 'Load Examples',
            cancelText: 'Cancel',
            onConfirm: loadSamples
          });
        } else {
          loadSamples();
        }
      });

      document.getElementById('emptyLoadBtn').addEventListener('click', loadSamples);

      // Print / PDF Button
      document.getElementById('printBtn').addEventListener('click', () => {
        updatePrintHeader();
        window.print();
      });

      // Download HTML Button
      document.getElementById('downloadHtmlBtn').addEventListener('click', downloadHtmlFile);

      // CSV Export
      document.getElementById('exportCsvBtn').addEventListener('click', exportToCsv);

      // JSON Export
      document.getElementById('exportJsonBtn').addEventListener('click', exportToJson);

      // JSON Import
      document.getElementById('importJsonTrigger').addEventListener('click', () => {
        document.getElementById('jsonFileInput').click();
      });
      document.getElementById('jsonFileInput').addEventListener('change', handleJsonImport);

      // Clear All
      document.getElementById('clearAllBtn').addEventListener('click', () => {
        showModal({
          title: 'Clear Stuck Point Log?',
          body: 'Are you sure you want to delete all stuck points in this log? This cannot be undone.',
          confirmText: 'Clear All',
          cancelText: 'Keep Entries',
          onConfirm: () => {
            logState.stuckPoints = [];
            persistData();
            renderLog();
            showToast('All log entries cleared.', 'info');
          }
        });
      });
    });
  </script>
</body>
</html>
